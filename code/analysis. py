import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import spearmanr

# 1. Data Simulation (Based on Research Parameters)
np.random.seed(42)
hours = np.linspace(0, 2000, 100)
# Modeling DFRI (Digital Phonetic Reinforcement Index)
dfri = 100 * (1 - np.exp(-hours/600)) + np.random.normal(0, 2, 100)
# Modeling TRI (Teacher Relief Index)
tri = 100 * np.exp(-hours/500) + np.random.normal(0, 2, 100)

# 2. Statistical Analysis
rho, p_val = spearmanr(dfri, tri)
print(f"--- Research Statistics ---")
print(f"Spearman Correlation (DFRI vs TRI): {rho:.3f}")
print(f"P-value: {p_val:.4e}")

# 3. Generating Key Figures
def save_research_plots():
    # Plot 1: DFRI vs TRI Correlation
    plt.figure(figsize=(10, 6))
    sns.regplot(x=dfri, y=tri, scatter_kws={'alpha':0.6}, line_kws={'color':'red'})
    plt.title(f"Correlation Analysis: DFRI vs TRI (ρ = {rho:.3f})")
    plt.xlabel("Digital Phonetic Reinforcement Index (DFRI)")
    plt.ylabel("Teacher Relief Index (TRI)")
    plt.grid(True, linestyle='--', alpha=0.7)
    plt.savefig("dfri_correlation_reproduced.png")
    print("Saved: dfri_correlation_reproduced.png")

    # Plot 2: Phonetic Variability Decay
    variability = 0.8 * np.exp(-hours/400) + 0.1
    plt.figure(figsize=(10, 5))
    plt.plot(hours, variability, color='blue', linewidth=2)
    plt.fill_between(hours, variability, color='blue', alpha=0.1)
    plt.title("Phonetic Variability Decay Model")
    plt.xlabel("Exposure Hours")
    plt.ylabel("Standard Deviation (SD)")
    plt.savefig("sd_decay_reproduced.png")
    print("Saved: sd_decay_reproduced.png")

if __name__ == "__main__":
    save_research_plots()

