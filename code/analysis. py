
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

# 1. Load the Actual Dataset from the data folder
data_path = 'data/dfri_dataset.csv'

if os.path.exists(data_path):
    # Reading the CSV file we just created
    df = pd.read_csv(data_path)
    print("--- Dataset Loaded Successfully ---")
    print(df.head()) # Shows the first few rows
    
    # 2. Statistical Analysis: Spearman Correlation
    correlation = df['dfri_index'].corr(df['tri_index'], method='spearman')
    print(f"\nCalculated Spearman Correlation: {correlation:.3f}")

    # 3. Visualization: Digital Reinforcement vs Teacher Relief
    plt.figure(figsize=(10, 6))
    sns.regplot(data=df, x='dfri_index', y='tri_index', scatter_kws={'s': 100}, line_kws={'color':'red'})
    
    plt.title(f"Empirical Relationship: DFRI vs TRI (ρ = {correlation:.3f})", fontsize=14)
    plt.xlabel("Digital Phonetic Reinforcement Index (DFRI)", fontsize=12)
    plt.ylabel("Teacher Relief Index (TRI)", fontsize=12)
    plt.grid(True, linestyle='--', alpha=0.6)
    
    # Save the output to figures folder
    output_fig = "paper/figures/reproduced_correlation_analysis.png"
    plt.savefig(output_fig)
    print(f"\nAnalysis complete. Plot saved to: {output_fig}")

else:
    print(f"Error: Data file not found at {data_path}. Please ensure the CSV is in the 'data' folder.")
